{
  "name": "api-simples",
  "version": "2.0.0",
  "description": "API de tarefas em camadas (routes, services, repositories, models) com PostgreSQL e Docker Compose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --testPathIgnorePatterns=integration",
    "test:integration": "RUN_DB_TESTS=1 jest tests/integration --runInBand",
    "test:all": "RUN_DB_TESTS=1 jest --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
